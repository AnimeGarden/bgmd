        "actors": [
          {
            "images": {
              "small": "https://lain.bgm.tv/r/100/pic/crt/l/85/9b/3918_seiyu_anidb.jpg",
              "grid": "https://lain.bgm.tv/pic/crt/g/85/9b/3918_seiyu_anidb.jpg",
